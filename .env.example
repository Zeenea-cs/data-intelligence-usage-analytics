# Actian Data Intelligence Companion -- environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# The four values marked REQUIRED have no working default.

# ---------------------------------------------------------------------------
# Actian instance connection
# ---------------------------------------------------------------------------

# REQUIRED. Full base URL of the Actian / Zeenea instance, no trailing slash.
ACTIAN_INSTANCE_URL=https://your-instance.zeenea.app

# REQUIRED. API key, sent as the `X-API-SECRET` header to the Audit, Catalog and
# User Management APIs (SCIM uses it as a Bearer token). Treat as a secret.
ACTIAN_API_KEY=replace-with-your-api-key

# ---------------------------------------------------------------------------
# Collection schedule
# ---------------------------------------------------------------------------

# Cron expression controlling how often a collection cycle runs.
# Default: daily at midnight. (One immediate run also happens on startup.)
COLLECT_CRON=0 0 * * *

# ---------------------------------------------------------------------------
# Companion PostgreSQL database (service `db`, database `actian_companion`)
# ---------------------------------------------------------------------------

# Hostname of the companion Postgres. Within Docker Compose this is the service
# name `db`; use `localhost` only when running the collector outside Compose.
POSTGRES_HOST=db

# Port of the companion Postgres.
POSTGRES_PORT=5432

# Companion database name.
POSTGRES_DB=actian_companion

# Companion database user.
POSTGRES_USER=actian

# REQUIRED. Companion database password. Choose a strong value.
POSTGRES_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Metabase
# ---------------------------------------------------------------------------

# REQUIRED. Password for Metabase's own application database (service
# `metabase-db`), kept separate from `actian_companion`. Choose a strong value.
METABASE_DB_PASSWORD=change-me-another-strong-password

# --- Metabase setup script (scripts/setup_metabase.py) ---------------------
# Only used by the one-off setup script; all have safe defaults if unset.

# Base URL the setup script talks to.
METABASE_URL=http://localhost:3000

# Admin account the script creates (first run) / logs in as (re-runs).
METABASE_ADMIN_EMAIL=admin@actian-companion.local
# Choose a strong value; Metabase rejects common/short passwords.
METABASE_ADMIN_PASSWORD=change-me-metabase-admin-password

# Metabase site name.
METABASE_SITE_NAME=Actian Data Intelligence Companion

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Python log level for the collector: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# --- Trigger web UI (served by the collector) ------------------------------
# Bind address and port for the on-demand collection web UI. The port is also
# mapped in docker-compose.yml.
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8000
