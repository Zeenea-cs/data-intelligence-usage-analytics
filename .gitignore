# Secrets / local config -- NEVER commit real credentials
# Match .env and any .env.<suffix> variant (e.g. .env.acme), but
# keep the committed template. `.env.*` is needed because `*.env` only matches
# names ending in `.env`, missing files like `.env.acme`.
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
*.egg-info/
.mypy_cache/

# Shared runtime logs (written by the services; not source)
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
